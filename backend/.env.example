# Copy to backend/.env — never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local: docker compose up -d db
# Supabase: Connect -> Transaction pooler (port 6543). The direct db.<ref>.supabase.co host is IPv6-only.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/repoatlas

# Allowed browser origins: comma-separated or a JSON list
CORS_ORIGINS=http://localhost:3000

# Optional: fine-grained token with public read access (raises limit 60 -> 5000 req/h)
GITHUB_TOKEN=

# Supabase Auth (Project Settings -> API)
SUPABASE_URL=https://<project-ref>.supabase.co
# Only needed for projects still on legacy HS256 JWT secrets
SUPABASE_JWT_SECRET=

# Ingestion limits
MAX_FILES=1500
MAX_FILE_BYTES=300000

# embedded | standalone | off
WORKER_MODE=embedded

# Optional AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
