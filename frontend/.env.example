# FastAPI backend base URL (no trailing slash). Paths already include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (GitHub OAuth). Leave blank to run anonymously — graph features keep working,
# sign-in shows a "not configured" state.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the new publishable key (sb_publishable_...); the legacy anon key is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Docs site (defaults to https://aadithyaale.github.io/repoatlas/)
NEXT_PUBLIC_DOCS_URL=

# Public origin of this app, used for OAuth redirects outside the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
