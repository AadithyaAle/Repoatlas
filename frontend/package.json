{
  "name": "repoatlas-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "bash ./scripts/bootstrap.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "cd ../backend && uv run python -m app.scripts.dump_openapi > ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts",
    "gen:api:fallback": "cd ../backend && uv run python -c \"import json; from app.main import app; print(json.dumps(app.openapi(), indent=2, sort_keys=True))\" > ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@monaco-editor/react": "4.7.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
